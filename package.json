{
  "name": "pearl-web-wallet",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "description": "Non-custodial pure-web wallet for PRL + WPRL with native PearlBridge integration",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/sync-version.mjs && vite",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc --noEmit && vite build",
    "build:offline": "node scripts/sync-version.mjs && tsc --noEmit && vite build --config vite.config.offline.ts && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "vite build --config vite.core.config.ts",
    "check:core": "npm run build:core && node tools/check-browser-core.mjs",
    "check:core:reference": "npm run build:core && node tools/check-browser-core.mjs --native",
    "build:xmss": "node tools/build-xmss.mjs",
    "build:extension": "npm run typecheck && node tools/build-extension.mjs",
    "check:extension": "npm run build:extension && node tools/check-wallet-extension.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@noble/post-quantum": "^0.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/base": "1.1.9",
    "@scure/bip32": "1.5.0",
    "@scure/bip39": "1.4.0",
    "@scure/btc-signer": "^1.4.0",
    "@sommetlabs/pearl-wallet-connect": "file:./packages/connector",
    "@tanstack/react-query": "^5.59.0",
    "dexie": "^4.0.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "viem": "2.21.19",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ws": "^8.22.0"
  }
}
