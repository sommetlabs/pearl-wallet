{
  "name": "abyss-wallet",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Abyss Wallet browser extension for Pearl",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run typecheck && node tools/build-extension.mjs",
    "build:extension": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "vite build --config vite.core.config.ts",
    "check:core": "npm run build:core && node tools/check-browser-core.mjs",
    "check:core:reference": "npm run build:core && node tools/check-browser-core.mjs --native",
    "build:xmss": "node tools/build-xmss.mjs",
    "check:extension": "npm run build && node tools/check-wallet-extension.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/base": "1.1.9",
    "@scure/bip32": "1.5.0",
    "@scure/bip39": "1.4.0",
    "@scure/btc-signer": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ws": "^8.22.0"
  },
  "workspaces": [
    "packages/connector"
  ]
}
